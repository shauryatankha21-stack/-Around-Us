{
  "name": "around-us-server",
  "version": "1.0.0",
  "description": "Around Us — Node.js/Express backend",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('../client')){require('child_process').execSync('cd ../client && npm install && npm run build',{stdio:'inherit'})}\"",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "private": true
}